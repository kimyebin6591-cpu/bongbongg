        pairing: "따뜻한 아메리카노 혹은 진한 홍차, 바닐라 아이스크림"
      },
      5: {
        name: "브라우니",
        french: "Brownie Fondant au Chocolat",
        categoryName: "디저트",
        price: "5,500원",
